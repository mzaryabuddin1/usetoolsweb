RewriteEngine On

# Force HTTPS in production
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# SEO files
RewriteRule ^sitemap\.xml$ sitemap.php [L]
RewriteRule ^robots\.txt$ robots.php [L]
RewriteRule ^site\.webmanifest$ site.webmanifest [L]
RewriteRule ^favicon\.ico$ assets/images/favicon-32x32.png [L]
RewriteRule ^f/([a-f0-9]{32})$ share-download.php?token=$1 [L,QSA]
RewriteRule ^s/([a-f0-9]{32})$ share-view.php?token=$1 [L,QSA]

# Clean URLs: /compress-image -> compress-image.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([^/.]+)/?$ $1.php [L]

# Default document
DirectoryIndex index.php
